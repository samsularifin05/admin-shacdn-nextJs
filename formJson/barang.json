{
  "moduleName": "Barang",
  "resourceName": "barangs",
  "tableName": "tm_barang",
  "title": "Barang",
  "route": "/admin/barang",
  "classForm": "grid grid-cols-1 md:grid-cols-2 gap-4",
  "fields": [
    {
      "name": "kodeBarang",
      "label": "Kode Barang",
      "type": "text",
      "autoCode": "{00000000}"
    },
    {
      "name": "kategori",
      "label": "Kategori",
      "type": "async-select",
      "endpoint": "/api/kategoris",
      "labelField": "kodeGroup",
      "valueField": "id"
    },
    {
      "name": "jenis",
      "label": "Jenis",
      "type": "async-select",
      "endpoint": "/api/jenis",
      "labelField": "kodeJenis",
      "valueField": "id",
      "dependency": {
        "field": "kategori",
        "queryParam": "kodeGroup"
      }
    },
    {
      "name": "kodeBaki",
      "label": "Kode Baki",
      "type": "async-select",
      "endpoint": "/api/bakis",
      "labelField": "kodeBaki",
      "valueField": "id"
    },
    {
      "name": "barangSepuhan",
      "label": "Barang Sepuhan",
      "type": "select",
      "options": ["TIDAK", "YA"],
      "defaultValue": "TIDAK"
    },
    {
      "name": "stockSepuh",
      "label": "Stock Sepuh",
      "type": "gram",
      "readOnly": true,
      "defaultValue": 0
    },
    {
      "name": "beratSepuh",
      "label": "Berat Sepuh",
      "type": "gram",
      "readOnly": true,
      "defaultValue": 0
    },
    {
      "name": "kodeIntern",
      "label": "Kode Intern",
      "type": "text"
    },
    {
      "name": "markis",
      "label": "Markis",
      "type": "select",
      "options": ["TIDAK", "YA"],
      "defaultValue": "TIDAK"
    },
    {
      "name": "namaBarang",
      "label": "Nama Barang",
      "type": "text"
    },
    {
      "name": "beratAsli",
      "label": "Berat Asli",
      "type": "gram",
      "defaultValue": 0
    },
    {
      "name": "berat",
      "label": "Berat",
      "type": "gram",
      "defaultValue": 0
    },
    {
      "name": "kadarCetak",
      "label": "Kadar Cetak",
      "type": "text"
    },
    {
      "name": "attributeName",
      "label": "Attribute Name",
      "type": "text"
    },
    {
      "name": "beratAtribut",
      "label": "Berat Atribut",
      "type": "gram",
      "defaultValue": 0
    },
    {
      "name": "hargaAtribut",
      "label": "Harga Atribut",
      "type": "rupiah",
      "defaultValue": 0
    },
    {
      "name": "beratPlastik",
      "label": "Berat Plastik",
      "type": "gram",
      "defaultValue": 0
    },
    {
      "name": "size",
      "label": "Size",
      "type": "text"
    },
    {
      "name": "stock",
      "label": "Stock",
      "type": "number",
      "defaultValue": 10
    },
    {
      "name": "hargaJual",
      "label": "Harga Jual",
      "type": "rupiah",
      "defaultValue": 100000
    }
  ]
}
