{
  "moduleName": "SalesTransaction",
  "resourceName": "sales-transactions",
  "tableName": "tm_sales_transaction",
  "title": "Sales Transaction",
  "route": "/admin/sales-transaction",
  "classForm": "grid grid-cols-1 md:grid-cols-1 gap-4",
  "fields": [
    {
      "name": "transactionCode",
      "label": "Transaction Code",
      "type": "text",
      "autoCode": "CC-FJ-{YYYYMMDD}-{0000}"
    },
    {
      "name": "barcode",
      "label": "Barcode",
      "type": "text",
      "autoCode": "{00000000}"
    },
    {
      "name": "customerName",
      "label": "Customer Name",
      "type": "text",
      "required": true
    },
    {
      "name": "totalAmount",
      "label": "Total Amount",
      "type": "rupiah",
      "defaultValue": 0
    }
  ]
}
