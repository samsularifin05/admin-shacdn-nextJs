{
  "moduleName": "Banner",
  "resourceName": "banners",
  "tableName": "tm_banner",
  "title": "Banner Promo",
  "route": "/admin/banner",
  "classForm": "grid grid-cols-1 md:grid-cols-1 gap-4",
  "fields": [
    {
      "name": "name",
      "label": "Nama Banner",
      "type": "string",
      "required": true
    },
    {
      "name": "image",
      "label": "Gambar Banner",
      "type": "file",
      "uploadDir": "assets/banners",
      "required": true
    },
    {
      "name": "link",
      "label": "Link Tujuan (URL)",
      "type": "string",
      "required": false,
      "uppercase": false
    },
    {
      "name": "sequence",
      "label": "Urutan Tampil",
      "type": "number",
      "defaultValue": 1
    },
    {
      "name": "isActive",
      "label": "Aktif",
      "type": "boolean",
      "defaultValue": true
    },
    {
      "name": "description",
      "label": "Keterangan",
      "type": "text",
      "required": false,
      "uppercase": false
    }
  ]
}
