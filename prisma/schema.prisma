// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String   @default("") // Added password as requested
  role      String   @default("User")
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model tm_baki {
  id           Int      @id @default(autoincrement())
  kodeGudang   String
  kodeBaki     String
  namaBaki     String
  beratBaki    Float
  beratBandrol Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tmBarangs tm_barang[]
}

model tm_banks {
  id             Int      @id @default(autoincrement())
  code           String
  name           String
  category       String
  balance        Float
  conversionRate Float
  totalValue     Float
  isActive       Boolean
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model tm_barang {
  id                        Int                           @id @default(autoincrement())
  kodeBarang                String
  kategori                  Int?
  kategoriRel               tm_kategori?                  @relation(fields: [kategori], references: [id])
  jenis                     Int?
  jenisRel                  tm_jenis?                     @relation(fields: [jenis], references: [id])
  kodeBaki                  Int?
  kodeBakiRel               tm_baki?                      @relation(fields: [kodeBaki], references: [id])
  barangSepuhan             String
  stockSepuh                Float
  beratSepuh                Float
  kodeIntern                String
  markis                    String
  namaBarang                String
  beratAsli                 Float
  berat                     Float
  kadarCetak                String
  attributeName             String
  beratAtribut              Float
  hargaAtribut              Float
  beratPlastik              Float
  size                      String
  stock                     Float
  hargaJual                 Float
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  tmSalesTransactionDetails tm_sales_transaction_detail[]

  @@index([kategori])
  @@index([jenis])
  @@index([kodeBaki])
}

model tm_jenis {
  id           Int          @id @default(autoincrement())
  kodeJenis    String
  namaJenis    String
  kodeGroup    Int?
  kodeGroupRel tm_kategori? @relation(fields: [kodeGroup], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  tmBarangs    tm_barang[]

  @@index([kodeGroup])
}

model tm_kategori {
  id            Int      @id @default(autoincrement())
  kodeGroup     String
  namaGroup     String
  jenisGroup    String
  harga         Float
  hargaModal    Float
  kodeWarnaNota String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tmBarangs tm_barang[]
  tmJenis   tm_jenis[]
}

model tm_sales_transaction {
  id              Int                           @id @default(autoincrement())
  transactionCode String
  transactionDate String
  customerName    String
  items           tm_sales_transaction_detail[]
  totalAmount     Float
  paymentMethod   String
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
}

model tm_sales_transaction_detail {
  id          Int                  @id @default(autoincrement())
  parentId    Int
  parent      tm_sales_transaction @relation(fields: [parentId], references: [id], onDelete: Cascade)
  barangId    Int?
  barangIdRel tm_barang?           @relation(fields: [barangId], references: [id])
  harga       Float
  qty         Float
  subtotal    Float                @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([parentId])
}
